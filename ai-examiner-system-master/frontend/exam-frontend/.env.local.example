# URL of the FastAPI backend Cloud Run service (no trailing slash)
BACKEND_URL=https://ai-exam-backend-XXXXX-me-west1.a.run.app

# Google Cloud SA key JSON for minting ID tokens (local dev only).
# On Cloud Run, leave empty — default SA is used automatically.
GOOGLE_SA_KEY_JSON=

# Exam duration in seconds (used server-side)
EXAM_DURATION_SECONDS=900

# Exam duration exposed to the browser
NEXT_PUBLIC_EXAM_DURATION_SECONDS=900

# QA / testing mode — enables /qa and /qa/results pages and the /api/exam/results endpoint
# Set both when running QA mode locally or on a dedicated QA Cloud Run revision
QA_MODE=true
NEXT_PUBLIC_QA_MODE=true
