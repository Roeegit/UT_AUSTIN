# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy this file to .env and fill in real values.
# .env is listed in .gitignore and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM providers ────────────────────────────────────────────────────────────

# Anthropic (required)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (optional — only needed if Anthropic is overloaded)
GEMINI_API_KEY=AIza...

# ── GitHub App authentication ─────────────────────────────────────────────────
# Create a GitHub App at  https://github.com/settings/apps
# Install it on your organisation and note the Installation ID.

GITHUB_APP_ID=123456

# Option A: paste the full PEM content here (replace real newlines with \n)
GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----

# Option B: point to the downloaded .pem file instead of pasting it above
# GITHUB_PRIVATE_KEY_PATH=C:\path\to\your-app-key.pem

GITHUB_INSTALLATION_ID=78901234

# ── GitHub repo resolution (pattern-based) ────────────────────────────────────
# GitHub Classroom names student repos as "{assignment-slug}-{username}".
# Set GITHUB_ORG to your organisation. GITHUB_REPO_PATTERN defaults to
# "{assignment_name}-{github_username}" which uses ASSIGNMENT_NAME from config.py —
# so you usually only need to set GITHUB_ORG here.
#
# Override GITHUB_REPO_PATTERN only if the actual repo naming differs.

GITHUB_ORG=BIU-OS-2025
# GITHUB_REPO_PATTERN={assignment_name}-{github_username}   # this is the default

# Branch and subfolder where the .c files live in each student repo
GITHUB_BRANCH=main
GITHUB_FILES_PATH=
